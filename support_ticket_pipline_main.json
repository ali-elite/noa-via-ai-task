    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Merge classification result with ticket data ──\nlet ticket;\ntry { ticket = $('No Attachment (Pass Through)').item.json; } catch(e) {}\nif (!ticket) try { ticket = $('Merge PDF into Ticket').item.json; } catch(e) {}\nconst classification = $input.item.json?.output || $input.item.json || {};\nlet log = ticket.processing_log || '';\n\nif ($input.item.json?.error || !classification.Category) {\n  log += `\\n[${new Date().toISOString()}] Classification LLM failed: ${$input.item.json?.error?.message || 'Unknown error'}`;\n  return {\n    json: {\n      ...ticket,\n      Category: \"general\",\n      Urgency: \"medium\",\n      Sentiment: \"neutral\",\n      Confidence: 0.0,\n      Summary: \"Classification failed due to AI error.\",\n      processing_log: log,\n      error: true\n    }\n  };\n}\n\nlog += `\\n[${new Date().toISOString()}] Classification complete — Category: ${classification.Category}, Urgency: ${classification.Urgency}, Confidence: ${classification.Confidence}`;\n\nreturn {\n  json: {\n    ticket_id: ticket.ticket_id,\n    timestamp: ticket.timestamp,\n    Name: ticket.Name,\n    Email: ticket.Email,\n    Subject: ticket.Subject,\n    Message: ticket.Message,\n    Category: classification.Category || \"general\",\n    Urgency: classification.Urgency || \"medium\",\n    Sentiment: classification.Sentiment || \"neutral\",\n    Confidence: classification.Confidence || 0,\n    Summary: classification.Summary || \"Failed to parse summary\",\n    processing_log: log\n  }\n};"
      },
      "id": "bc438fa2-cbb8-4acc-b12b-7e2172ec876b",
      "name": "Merge Classification Results",
      "position": [
        1104,
        384
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Build final ticket record before routing ──\nconst merged = $('Merge Classification Results').item.json;\nlet log = merged.processing_log || '';\n\nlet ragOutput = \"\";\nif ($input.item.json?.error || merged.error) {\n  log += `\\n[${new Date().toISOString()}] RAG generation failed: ${$input.item.json?.error?.message || 'Unknown error or upstream error'}`;\n  ragOutput = \"We apologize, but we are currently experiencing high volume and our automated drafting failed. A human agent will review this ticket soon.\";\n} else {\n  ragOutput = $input.item.json.output || $input.item.json.text || '';\n  log += `\\n[${new Date().toISOString()}] RAG draft response generated (${ragOutput.length} chars)`;\n}\n\n// Determine status based on confidence\nconst confidence = parseFloat(merged.Confidence) || 0;\nlet status = (merged.error || $input.item.json?.error) ? 'failed' : 'processed';\nif (status !== 'failed' && confidence < 0.6) {\n  status = 'needs-manual-review';\n  log += `\\n[${new Date().toISOString()}] LOW CONFIDENCE (${confidence}) — flagged for manual review`;\n}\n\n// Extract knowledge sources from the RAG response text (look for markdown links or [Source: x])\nlet knowledgeSources = 'N/A';\nconst sourceMatches = ragOutput.match(/\\[Source:\\s*([^\\]]+)\\]/gi);\nif (sourceMatches) {\n  knowledgeSources = [...new Set(sourceMatches.map(s => s.replace(/\\[Source:\\s*|\\]/gi, '').trim()))].join(', ');\n} else if (ragOutput.includes('No specific policy found') || ragOutput.includes('general knowledge')) {\n  knowledgeSources = 'None — general knowledge response';\n} else {\n  // Fallback extraction\n  const fallbackMatches = ragOutput.match(/(?:refund|shipping|account|password|privacy|gdpr|sla|api|rate|acceptable|subscription|troubleshooting|faq|policy|documentation)/gi);\n  if (fallbackMatches) {\n     knowledgeSources = [...new Set(fallbackMatches.map(s => s.toLowerCase()))].join(', ');\n  }\n}\n\nlog += `\\n[${new Date().toISOString()}] Final status: ${status}`;\n\nreturn {\n  json: {\n    ticket_id: merged.ticket_id,\n    timestamp: merged.timestamp,\n    Name: merged.Name,\n    Email: merged.Email,\n    Subject: merged.Subject,\n    Message: merged.Message,\n    Category: merged.Category,\n    Urgency: merged.Urgency,\n    Sentiment: merged.Sentiment,\n    Confidence: confidence,\n    Summary: merged.Summary,\n    draft_response: ragOutput,\n    knowledge_sources: knowledgeSources,\n    status: status,\n    processing_log: log\n  }\n};"
      },
