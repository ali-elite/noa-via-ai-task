      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "parameters": {
        "content": "## 4. Routing Logic\n\n- **Critical/High** → Full HTML email + Google Sheets\n- **Medium** → Brief email summary + Google Sheets\n- **Low** → Google Sheets only\n- **Confidence < 0.6** → status = 'needs-manual-review'",
        "height": 192,
        "width": 288
      },
      "id": "10e588ad-c9dc-40c0-943a-b1f61ec9edc7",
