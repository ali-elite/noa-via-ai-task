      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Merge PDF text (if successful) into Message ──\nconst prev = $('Validate Input & Generate ID').item.json;\nlet log = prev.processing_log || '';\nlet message = prev.Message;\n\n// Check if PDF extraction succeeded\nconst extractedText = $input.item.json?.data;\nconst extractionError = $input.item.json?.error;\n\nif (extractionError || !extractedText) {\n  log += `\\n[${new Date().toISOString()}] PDF extraction failed — processing without attachment`;\n} else {\n  log += `\\n[${new Date().toISOString()}] PDF text extracted successfully (${extractedText.length} chars)`;\n  message = message + '\\n\\n--- Attached PDF Content ---\\n' + extractedText;\n}\n\nreturn {\n  json: {\n    ticket_id: prev.ticket_id,\n    timestamp: prev.timestamp,\n    Name: prev.Name,\n    Email: prev.Email,\n    Subject: prev.Subject,\n    Message: message,\n    processing_log: log\n  }\n};"
      },
