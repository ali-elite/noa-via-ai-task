      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Build final ticket record before routing ──\nconst merged = $('Merge Classification Results').item.json;\nconst ragOutput = $input.item.json.output || $input.item.json.text || '';\nlet log = merged.processing_log || '';\n\nlog += `\\n[${new Date().toISOString()}] RAG draft response generated (${ragOutput.length} chars)`;\n\n// Determine status based on confidence\nconst confidence = parseFloat(merged.Confidence) || 0;\nlet status = 'processed';\nif (confidence < 0.6) {\n  status = 'needs-manual-review';\n  log += `\\n[${new Date().toISOString()}] LOW CONFIDENCE (${confidence}) — flagged for manual review`;\n}\n\n// Extract knowledge sources from the RAG response text\nlet knowledgeSources = 'N/A';\nconst sourceMatches = ragOutput.match(/(?:refund|shipping|account|password|privacy|gdpr|sla|api|rate|acceptable|subscription|troubleshooting|faq|policy|documentation)/gi);\nif (sourceMatches) {\n  knowledgeSources = [...new Set(sourceMatches.map(s => s.toLowerCase()))].join(', ');\n}\nif (ragOutput.includes('No specific policy found') || ragOutput.includes('general knowledge')) {\n  knowledgeSources = 'None — general knowledge response';\n}\n\nlog += `\\n[${new Date().toISOString()}] Final status: ${status}`;\n\nreturn {\n  json: {\n    ticket_id: merged.ticket_id,\n    timestamp: merged.timestamp,\n    Name: merged.Name,\n    Email: merged.Email,\n    Subject: merged.Subject,\n    Message: merged.Message,\n    Category: merged.Category,\n    Urgency: merged.Urgency,\n    Sentiment: merged.Sentiment,\n    Confidence: confidence,\n    Summary: merged.Summary,\n    draft_response: ragOutput,\n    knowledge_sources: knowledgeSources,\n    status: status,\n    processing_log: log\n  }\n};"
      },
