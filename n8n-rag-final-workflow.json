      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Validate & Generate Ticket ID ──\nconst body = $input.item.json.body || $input.item.json;\nconst errors = [];\nconst log = [];\n\nlog.push(`[${new Date().toISOString()}] Ticket received`);\n\n// Required fields\nconst name = (body.Name || body.name || '').toString().trim();\nconst email = (body.Email || body.email || '').toString().trim();\nconst subject = (body.Subject || body.subject || '').toString().trim();\nconst message = (body.Message || body.message || '').toString().trim();\n\nif (!name)    errors.push('Name is required');\nif (!email)   errors.push('Email is required');\nif (!subject) errors.push('Subject is required');\nif (!message || message.length === 0) errors.push('Message body is required and must not be empty');\n\n// Email format validation\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (email && !emailRegex.test(email)) {\n  errors.push('Email must be a valid format (e.g. user@example.com)');\n}\n\nconst newItem = {};\nif ($input.item.binary) {\n  newItem.binary = $input.item.binary;\n}\n\nif (errors.length > 0) {\n  log.push(`[${new Date().toISOString()}] Validation FAILED: ${errors.join('; ')}`);\n  newItem.json = {\n    valid: false,\n    errors,\n    processing_log: log.join('\\n')\n  };\n  return newItem;\n}\n\n// Generate ticket ID  (TKT-YYYYMMDD-XXXX)\nconst now = new Date();\nconst datePart = now.toISOString().slice(0,10).replace(/-/g,'');\nconst rand = Math.random().toString(36).substr(2, 6).toUpperCase();\nconst ticketId = `TKT-${datePart}-${rand}`;\n\nlog.push(`[${new Date().toISOString()}] Validation passed — Ticket ID: ${ticketId}`);\n\nnewItem.json = {\n  valid: true,\n  ticket_id: ticketId,\n  timestamp: now.toISOString(),\n  Name: name,\n  Email: email,\n  Subject: subject,\n  Message: message,\n  processing_log: log.join('\\n')\n};\n\nreturn newItem;"
      },
