        "inputSchema": "{\"type\":\"object\",\"properties\":{\"Category\":{\"type\":\"string\",\"enum\":[\"billing\",\"technical\",\"account\",\"product\",\"shipping\",\"general\"]},\"Urgency\":{\"type\":\"string\",\"enum\":[\"critical\",\"high\",\"medium\",\"low\"]},\"Sentiment\":{\"type\":\"string\",\"enum\":[\"angry\",\"frustrated\",\"neutral\",\"positive\"]},\"Confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"Summary\":{\"type\":\"string\"}},\"required\":[\"Category\",\"Urgency\",\"Sentiment\",\"Confidence\",\"Summary\"]}",
