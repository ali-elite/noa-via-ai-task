    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Merge PDF text (if successful) into Message ──\nconst prev = $('Validate Input & Generate ID').item.json;\nlet log = prev.processing_log || '';\nlet message = prev.Message;\n\n// Check if PDF extraction succeeded (handles .text or .data)\nconst extractedText = $input.item.json?.text || $input.item.json?.data || '';\nconst extractionError = $input.item.json?.error;\n\nif (extractionError || extractedText.length === 0) {\n  log += `\\n[${new Date().toISOString()}] PDF extraction returned no text — processing as text-only ticket`;\n} else {\n  log += `\\n[${new Date().toISOString()}] PDF text extracted successfully (${extractedText.length} chars)`;\n  message = message + '\\n\\n--- Attached PDF Content ---\\n' + extractedText;\n}\n\nreturn {\n  json: {\n    ticket_id: prev.ticket_id,\n    timestamp: prev.timestamp,\n    Name: prev.Name,\n    Email: prev.Email,\n    Subject: prev.Subject,\n    Message: message,\n    processing_log: log\n  }\n};"
      },
      "id": "0978e3d5-66fe-4461-811d-7bc285243e96",
      "name": "Merge PDF into Ticket",
      "position": [
        -208,
        352
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ── Pass through without PDF ──\nconst prev = $('Validate Input & Generate ID').item.json;\nlet log = prev.processing_log || '';\nlog += `\\n[${new Date().toISOString()}] No attachment — proceeding with text-only ticket`;\n\nreturn {\n  json: {\n    ticket_id: prev.ticket_id,\n    timestamp: prev.timestamp,\n    Name: prev.Name,\n    Email: prev.Email,\n    Subject: prev.Subject,\n    Message: prev.Message,\n    processing_log: log\n  }\n};"
      },
