        "message": "=<h2>🚨 Urgent Support Ticket Notification</h2>\n<table style=\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;\">\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Ticket ID</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.ticket_id }}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Customer</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.Name }} ({{ $json.Email }})</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Subject</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.Subject }}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Category</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.Category }}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Urgency</td><td style=\"padding:8px;border:1px solid #ddd;color:red;font-weight:bold;\">{{ $json.Urgency }}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Sentiment</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.Sentiment }}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd;font-weight:bold;\">Confidence</td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $json.Confidence }}</td></tr>\n</table>\n<h3>AI Summary</h3>\n<p>{{ $json.Summary }}</p>\n<h3>Customer Message</h3>\n<p>{{ $json.Message }}</p>\n<h3>Draft Response</h3>\n<blockquote style=\"border-left:3px solid #ccc;padding:10px;margin:10px 0;background:#f9f9f9;\">{{ $json.draft_response }}</blockquote>\n<p style=\"color:#888;font-size:12px;\">Knowledge sources: {{ $json.knowledge_sources }}<br>Status: {{ $json.status }}</p>",
        "options": {}
      },
